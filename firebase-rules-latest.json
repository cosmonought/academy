{
  "rules": {
    ".read": false,
    ".write": false,
    "banned": {
      ".read": false,
      ".write": false
    },
    "chat": {
      "cinema": {
        "messages": {
          ".read": true,
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists()",
          "$messageId": {
            ".validate": "newData.hasChildren(['name','text','timestamp','uid']) && newData.child('uid').val() === auth.uid",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "disabled": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    },
    "academyRegistrations": {
      ".read": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
      "$emailKey": {
        "$seminarId": {
          ".read": "(auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org') || (auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && (!data.exists() || (auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && (data.child('accountUid').val() === auth.uid || (!data.child('accountUid').exists() && auth.token.email_verified === true)))))",
          ".validate": "newData.hasChildren(['email','name','xHandle','reason','requestedAt']) && ($seminarId !== 'sex-monsters-superheroes' || (newData.child('policyAccepted').val() === true && newData.child('policyVersion').val() === '2026-09-29' && newData.child('policyAcceptedAt').isNumber()))",
          "email": {
            ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120 && newData.val() === auth.token.email.toLowerCase()"
          },
          "name": {
            ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "xHandle": {
            ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "reason": {
            ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "requestedAt": {
            ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "accountUid": {
            ".write": "(auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid) || (auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org')",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "policyAccepted": {
            ".write": "(auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid) || (auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org')",
            ".validate": "newData.isBoolean()"
          },
          "policyVersion": {
            ".write": "(auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid) || (auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org')",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
          },
          "policyAcceptedAt": {
            ".write": "(auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && !data.parent().exists() && newData.parent().child('accountUid').val() === auth.uid) || (auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org')",
            ".validate": "newData.isNumber()"
          },
          "enrolled": {
            ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
            ".validate": "newData.isBoolean()"
          },
          "attendance": {
            "$sessionKey": {
              ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
              ".validate": "newData.isBoolean()"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "accountMeta": {
      "$emailKey": {
        ".read": "auth != null && (auth.token.email === 'academy@netadao.org' || $emailKey === auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').toLowerCase())",
        "hasPassword": {
          ".write": "auth != null && $emailKey === auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').toLowerCase()",
          ".validate": "newData.isBoolean()"
        },
        "displayName": {
          ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',')",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && !newData.val().beginsWith(' ') && !newData.val().endsWith(' ') && !newData.val().contains('\\n') && !newData.val().contains('\\r') && !newData.val().contains('\\t')"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "seminarReadings": {
      "$seminarId": {
        ".read": "auth != null && auth.token.email != null && root.child('academyRegistrations').child(auth.token.email.toLowerCase().replace('.', ',')).child($seminarId).child('enrolled').val() === true && (root.child('academyRegistrations').child(auth.token.email.toLowerCase().replace('.', ',')).child($seminarId).child('accountUid').val() === auth.uid || (!root.child('academyRegistrations').child(auth.token.email.toLowerCase().replace('.', ',')).child($seminarId).child('accountUid').exists() && auth.token.email_verified === true))",
        ".write": false
      }
    },
    "interestSignups": {
      ".read": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
      ".write": false,
      "$signupId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['email','submittedAt']) && newData.child('email').isString() && newData.child('email').val().length <= 120 && newData.child('email').val().length > 0",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "proposingLecture": {
          ".validate": "newData.isBoolean()"
        },
        "proposal": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "submittedAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "seminarInterests": {
      ".read": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
      ".write": false,
      "$interestId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name','email','seminarId','seminarTitle','state','notifyWhenEnrollmentOpens','submittedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "seminarId": {
          ".validate": "newData.isString() && newData.val() === 'sex-monsters-superheroes'"
        },
        "seminarTitle": {
          ".validate": "newData.isString() && newData.val() === 'Sex, Monsters, and Superheroes'"
        },
        "state": {
          ".validate": "newData.isString() && newData.val() === 'interested'"
        },
        "notifyWhenEnrollmentOpens": {
          ".validate": "newData.isBoolean() && newData.val() === true"
        },
        "submittedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "academyConfig": {
      "passwordAccountsEnabled": {
        ".read": true,
        ".write": false
      }
    },
    "evaluations": {
      ".read": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
      "$emailKey": {
        "$seminarId": {
          ".read": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org' || (auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && root.child('academyRegistrations').child($emailKey).child($seminarId).child('enrolled').val() === true && (root.child('academyRegistrations').child($emailKey).child($seminarId).child('accountUid').val() === auth.uid || (!root.child('academyRegistrations').child($emailKey).child($seminarId).child('accountUid').exists() && auth.token.email_verified === true)))",
          "request": {
            ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && $seminarId === 'sex-monsters-superheroes' && root.child('academyRegistrations').child($emailKey).child($seminarId).child('enrolled').val() === true && (root.child('academyRegistrations').child($emailKey).child($seminarId).child('accountUid').val() === auth.uid || (!root.child('academyRegistrations').child($emailKey).child($seminarId).child('accountUid').exists() && auth.token.email_verified === true)) && !data.parent().child('instructor').exists() && (newData.exists() || data.exists())",
            ".validate": "newData.hasChildren(['form','requestedAt','accountUid']) && newData.child('accountUid').val() === auth.uid",
            "form": {
              ".validate": "newData.isString() && (newData.val() === 'essay' || newData.val() === 'presentation' || newData.val() === 'discussion' || newData.val() === 'other')"
            },
            "requestedAt": {
              ".validate": "newData.isNumber()"
            },
            "accountUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            }
          },
          "instructor": {
            ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
            ".validate": "newData.hasChildren(['state','form','feedback']) && ((newData.child('state').val() === 'completed' && newData.child('outcome').exists()) || (newData.child('state').val() === 'agreed' && !newData.child('outcome').exists()))",
            "state": {
              ".validate": "newData.isString() && (newData.val() === 'agreed' || newData.val() === 'completed')"
            },
            "form": {
              ".validate": "newData.isString() && (newData.val() === 'essay' || newData.val() === 'presentation' || newData.val() === 'discussion' || newData.val() === 'other')"
            },
            "outcome": {
              ".validate": "newData.isString() && (newData.val() === 'completed' || newData.val() === 'merit' || newData.val() === 'distinction')"
            },
            "feedback": {
              ".validate": "newData.isString() && newData.val().length <= 10000"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "accountSeminarInterests": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email_verified === true && auth.token.email === 'academy@netadao.org'",
        "$seminarId": {
          ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && $seminarId === 'sex-monsters-superheroes' && !data.exists() && newData.child('accountUid').val() === auth.uid && newData.child('email').val() === auth.token.email.toLowerCase()",
          ".validate": "newData.hasChildren(['accountUid','email','submittedAt'])",
          "accountUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "email": {
            ".validate": "newData.isString() && newData.val() === auth.token.email.toLowerCase()"
          },
          "submittedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && (!data.exists() || data.child('accountUid').val() === auth.uid)"
        }
      }
    }
  }
}
